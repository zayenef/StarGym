<Window x:Class="StarGymApp.Desktop.MemberEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Member" Width="560" MinWidth="500" SizeToContent="Height" MaxHeight="820"
        WindowStartupLocation="CenterOwner" Icon="{StaticResource StarGymLogo}" Background="#F4F7FB" Foreground="#10233F"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="BlueBrush" Color="#1769E0" />
        <SolidColorBrush x:Key="DeepBlueBrush" Color="#0B2E68" />
        <SolidColorBrush x:Key="GoldBrush" Color="#B9D7FF" />
        <SolidColorBrush x:Key="InkBrush" Color="#10233F" />
        <SolidColorBrush x:Key="MutedBrush" Color="#6B7E99" />
        <SolidColorBrush x:Key="LineBrush" Color="#DDE6F2" />
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="#D4E0EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="#D4E0EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource DeepBlueBrush}" Padding="26,22">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="MEMBER MANAGEMENT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" />
                    <TextBlock x:Name="FormTitleText" Text="Member profile" FontSize="25" FontWeight="Bold" Foreground="White" Margin="0,6,0,0" />
                    <TextBlock x:Name="FormSubtitleText" Text="Update member contact details and status." FontSize="12" Foreground="#B9D7FF" Margin="0,5,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="27" Foreground="#B9D7FF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="22" Margin="24,20,24,14">
                <StackPanel>
                    <StackPanel x:Name="ProfilePanel">
                    <TextBlock Text="MEMBER PHOTO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BlueBrush}" Margin="0,0,0,10" />
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="88" Height="88" CornerRadius="44" Background="#EAF2FF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" ClipToBounds="True" VerticalAlignment="Top">
                            <Image x:Name="MemberPhotoPreview" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,4,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="PhotoInstructionText" Text="Capture a photo for badge check-in." FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                            <Button x:Name="CapturePhotoButton" Content="Open camera" Width="132" Height="34" HorizontalAlignment="Left" Margin="0,10,0,0" Click="CapturePhotoButton_OnClick" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="CONTACT DETAILS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BlueBrush}" Margin="0,0,0,14" />
                    <TextBlock Text="Full name" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                    <TextBox x:Name="FullNameBox" Height="42" Margin="0,6,0,16" />
                    <TextBlock Text="Badge ID" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                    <TextBox x:Name="BadgeIdBox" Height="42" Margin="0,6,0,16" />
                    <TextBlock Text="Age (years)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                    <TextBox x:Name="AgeBox" Height="42" Margin="0,6,0,16" ToolTip="Enter an age from 1 to 120." />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Phone" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                            <TextBox x:Name="PhoneBox" Height="42" Margin="0,6,0,16" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Email" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                            <TextBox x:Name="EmailBox" Height="42" Margin="0,6,0,16" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Membership status" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                    <ComboBox x:Name="StatusBox" Height="42" Margin="0,6,0,16" SelectedIndex="0">
                        <ComboBoxItem Content="Active" />
                        <ComboBoxItem Content="Expired" />
                        <ComboBoxItem Content="Paused" />
                        <ComboBoxItem Content="Inactive" />
                    </ComboBox>
                    <TextBlock Text="Notes" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                    <TextBox x:Name="NotesBox" Height="96" Margin="0,6,0,0" Padding="12,10" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" />
                    </StackPanel>
                    <Border x:Name="SubscriptionPanel" Background="#F4F8FE" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,18,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="SubscriptionHeadingText" Text="MEMBERSHIP PLAN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BlueBrush}" />
                            <TextBlock x:Name="SubscriptionDescriptionText" Text="Choose a plan to start this membership." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,12" TextWrapping="Wrap" />
                            <TextBlock Text="Plan" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                            <ComboBox x:Name="MembershipPlanBox" Height="42" Margin="0,6,0,12" DisplayMemberPath="Name" SelectionChanged="MembershipPlanBox_OnSelectionChanged" />
                            <TextBlock Text="Training period" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                            <ComboBox x:Name="MembershipDurationBox" Height="42" Margin="0,6,0,12" SelectionChanged="MembershipDurationBox_OnSelectionChanged">
                                <ComboBoxItem Content="1 month" Tag="1" />
                                <ComboBoxItem Content="2 months" Tag="2" />
                                <ComboBoxItem Content="3 months" Tag="3" />
                                <ComboBoxItem Content="4 months" Tag="4" />
                                <ComboBoxItem Content="5 months" Tag="5" />
                                <ComboBoxItem Content="6 months" Tag="6" />
                                <ComboBoxItem Content="7 months" Tag="7" />
                                <ComboBoxItem Content="8 months" Tag="8" />
                                <ComboBoxItem Content="9 months" Tag="9" />
                                <ComboBoxItem Content="10 months" Tag="10" />
                                <ComboBoxItem Content="11 months" Tag="11" />
                                <ComboBoxItem Content="12 months" Tag="12" />
                            </ComboBox>
                            <TextBlock x:Name="MembershipDatesText" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14" />
                            <CheckBox x:Name="RecordPaymentCheckBox" Content="Payment collected now — record it" IsChecked="True" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Checked="RecordPaymentCheckBox_OnChanged" Unchecked="RecordPaymentCheckBox_OnChanged" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Membership price (total)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                    <TextBox x:Name="PaymentAmountBox" Height="40" Margin="0,5,0,0" ToolTip="Enter the total price manually for the selected membership period." />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Payment method" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                    <ComboBox x:Name="PaymentMethodBox" Height="40" Margin="0,5,0,0" SelectedIndex="0">
                                        <ComboBoxItem Content="Cash" />
                                        <ComboBoxItem Content="Card" />
                                        <ComboBoxItem Content="Bank transfer" />
                                        <ComboBoxItem Content="Other" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,14" Background="#F4F7FB">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="94" Margin="0,0,10,0" Background="White" Foreground="#24405F" BorderBrush="#D4E0EF" Click="CancelButton_OnClick" />
                <Button x:Name="SaveButton" Content="Save member" Width="132" Background="{StaticResource BlueBrush}" Foreground="White" BorderBrush="{StaticResource BlueBrush}" Click="SaveButton_OnClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>