<Application x:Class="StarGymApp.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <DrawingImage x:Key="StarGymLogo">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#1769E0"
                                     Geometry="M 8,0 H 56 Q 64,0 64,8 V 56 Q 64,64 56,64 H 8 Q 0,64 0,56 V 8 Q 0,0 8,0 Z" />
                    <GeometryDrawing Brush="White"
                                     Geometry="M 32,5 L 39,23 L 59,23 L 43,35 L 49,56 L 32,44 L 15,56 L 21,35 L 5,23 L 25,23 Z" />
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        <SolidColorBrush x:Key="PageBrush" Color="#F4F7FB" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#1769E0" />
        <SolidColorBrush x:Key="MutedBrush" Color="#6B7E99" />
        <SolidColorBrush x:Key="BorderBrush" Color="#DDE6F2" />
    </Application.Resources>
</Application>
