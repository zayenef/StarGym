<UserControl x:Class="StarGymApp.Desktop.BadgeScannerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <SolidColorBrush x:Key="BlueBrush" Color="#1769E0" />
        <SolidColorBrush x:Key="DeepBlueBrush" Color="#0B2E68" />
        <SolidColorBrush x:Key="MutedBrush" Color="#6B7E99" />
        <SolidColorBrush x:Key="LineBrush" Color="#DDE6F2" />
        <SolidColorBrush x:Key="SoftBlueBrush" Color="#EAF2FF" />
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#10233F" />
            <Setter Property="BorderBrush" Value="#B9D7FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1769E0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource DeepBlueBrush}" CornerRadius="14" Padding="20,16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#B9D7FF" VerticalAlignment="Center" Margin="0,0,9,0" />
                        <TextBlock Text="ENTRY DESK / BADGE CHECK-IN" FontSize="11" FontWeight="Bold" Foreground="#B9D7FF" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Member check-in" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,5,0,0" />
                    <TextBlock Text="Scan a valid badge to record entry automatically." FontSize="13" Foreground="#D0E2FF" Margin="0,3,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#174887" BorderBrush="#3D6FAE" BorderThickness="1" CornerRadius="18" Padding="13,8" VerticalAlignment="Center" Margin="16,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#6DD5A4" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="READY TO SCAN" FontSize="10" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.88*" />
                    <ColumnDefinition Width="1.55*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource DeepBlueBrush}" CornerRadius="14" Padding="22" Margin="0,0,10,0">
                    <StackPanel>
                        <Border Background="#174887" CornerRadius="10" Padding="12" HorizontalAlignment="Left">
                            <TextBlock Text="SCAN BADGE" FontSize="10" FontWeight="Bold" Foreground="#D0E2FF" />
                        </Border>
                        <TextBlock Text="Identify your member" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,16,0,6" />
                        <TextBlock Text="Present or enter the member's physical badge ID. A valid scan records the visit and updates Member history." FontSize="13" Foreground="#D0E2FF" TextWrapping="Wrap" LineHeight="20" />
                        <TextBox x:Name="BadgeInput" Height="52" Margin="0,20,0,0" KeyDown="BadgeInput_OnKeyDown" ToolTip="Scan or enter badge ID, then press Enter" />
                        <Button Content="Find member" Height="44" Margin="0,10,0,0" Click="FindMemberButton_OnClick" />
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#B9D7FF" Margin="0,0,8,0" />
                            <TextBlock Text="Scanner sends Enter after reading the badge." FontSize="11" Foreground="#B9D7FF" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Background="#174887" CornerRadius="9" Padding="12" Margin="0,18,0,0">
                            <TextBlock x:Name="ScanStatusText" Text="Waiting for a badge..." Foreground="White" FontSize="12" TextWrapping="Wrap" LineHeight="18" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="22" Margin="10,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,22,18,0">
                            <Border Width="104" Height="104" CornerRadius="52" Background="{StaticResource SoftBlueBrush}" BorderBrush="#D8E6F8" BorderThickness="2" ClipToBounds="True">
                                <Image x:Name="MemberPhoto" Width="100" Height="100" Stretch="UniformToFill">
                                    <Image.Clip><EllipseGeometry Center="50,50" RadiusX="50" RadiusY="50" /></Image.Clip>
                                </Image>
                            </Border>
                            <TextBlock Text="PROFILE PHOTO" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" Margin="0,9,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="MEMBER PROFILE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BlueBrush}" />
                            <TextBlock x:Name="MemberNameText" Text="No member scanned" FontSize="23" FontWeight="Bold" Foreground="#10233F" Margin="0,6,0,14" TextWrapping="Wrap" />

                            <UniformGrid Columns="3" Margin="0,0,0,14">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="BADGE ID" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="BadgeText" Text="--" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BlueBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="PHONE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="PhoneText" Text="--" FontSize="12" Foreground="#10233F" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="AGE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="AgeText" Text="--" FontSize="12" Foreground="#10233F" Margin="0,4,0,0" />
                                </StackPanel>
                            </UniformGrid>

                            <Border Background="{StaticResource SoftBlueBrush}" BorderBrush="#D8E6F8" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                                <UniformGrid Columns="2">
                                    <StackPanel>
                                        <TextBlock Text="MEMBERSHIP STATUS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock x:Name="MembershipStatusText" Text="--" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BlueBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="EXPIRES" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock x:Name="ExpiryText" Text="--" FontSize="14" FontWeight="Bold" Foreground="#C54646" Margin="0,4,0,0" />
                                    </StackPanel>
                                </UniformGrid>
                            </Border>

                            <UniformGrid Columns="2">
                                <StackPanel>
                                    <TextBlock Text="MEMBERSHIP STARTED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="StartDateText" Text="--" FontSize="12" Foreground="#10233F" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="TOTAL PAID" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="TotalPaidText" Text="--" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BlueBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock x:Name="VisitsText" Text="Visits: --" Foreground="{StaticResource BlueBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,13,0,0" />
                            <TextBlock x:Name="LastPaymentText" Text="Last payment: --" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                            <Button x:Name="CheckInButton" Content="Check in member" Height="42" Margin="0,14,0,0" Click="CheckInButton_OnClick" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
