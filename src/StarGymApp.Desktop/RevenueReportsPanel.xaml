<UserControl x:Class="StarGymApp.Desktop.RevenueReportsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <SolidColorBrush x:Key="BlueBrush" Color="#1769E0" />
        <SolidColorBrush x:Key="DeepBlueBrush" Color="#0B2E68" />
        <SolidColorBrush x:Key="InkBrush" Color="#10233F" />
        <SolidColorBrush x:Key="MutedBrush" Color="#6B7E99" />
        <SolidColorBrush x:Key="LineBrush" Color="#DDE6F2" />
        <SolidColorBrush x:Key="SoftBlueBrush" Color="#EAF2FF" />
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#10233F" />
            <Setter Property="BorderBrush" Value="#D4E0EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Background="{StaticResource DeepBlueBrush}" CornerRadius="14" Padding="22,18" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#B9D7FF" VerticalAlignment="Center" Margin="0,0,9,0" />
                            <TextBlock Text="PERFORMANCE REPORTS" FontSize="11" FontWeight="Bold" Foreground="#B9D7FF" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Revenue performance" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,5,0,0" />
                        <TextBlock Text="Follow monthly and yearly paid revenue trends." FontSize="13" Foreground="#D0E2FF" Margin="0,3,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#174887" BorderBrush="#3D6FAE" BorderThickness="1" CornerRadius="10" Padding="12,8" VerticalAlignment="Center" Margin="18,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="REPORT YEAR" FontSize="9" FontWeight="Bold" Foreground="#B9D7FF" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox x:Name="YearFilter" Width="92" SelectionChanged="YearFilter_OnSelectionChanged" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="MONTHLY REVENUE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BlueBrush}" />
                            <TextBlock Text="Revenue by month" FontSize="19" FontWeight="Bold" Foreground="{StaticResource InkBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border DockPanel.Dock="Right" Background="{StaticResource SoftBlueBrush}" CornerRadius="9" Padding="10,6" VerticalAlignment="Center">
                            <TextBlock x:Name="SelectedYearText" Foreground="{StaticResource BlueBrush}" FontSize="12" FontWeight="Bold" />
                        </Border>
                    </DockPanel>
                    <Canvas x:Name="MonthlyTimelineCanvas" Height="270" Margin="0,4,0,0" Background="#FBFCFF" SizeChanged="MonthlyTimelineCanvas_OnSizeChanged" />
                    <ItemsControl Visibility="Collapsed" x:Name="MonthlyChart" Margin="0,22,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding PeriodLabel}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Height="18" Maximum="100" Value="{Binding BarWidth}" Foreground="{StaticResource BlueBrush}" Background="#E8EEF7" BorderThickness="0" />
                                    <TextBlock Grid.Column="2" Text="{Binding Revenue, StringFormat={}{0:N0}}" Foreground="{StaticResource InkBrush}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Background="#F5F9FF" BorderBrush="#CFE0F6" BorderThickness="1" CornerRadius="14" Padding="20">
                <StackPanel>
                    <TextBlock Text="YEARLY COMPARISON" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BlueBrush}" />
                    <TextBlock Text="Paid revenue by year" FontSize="19" FontWeight="Bold" Foreground="{StaticResource InkBrush}" Margin="0,4,0,0" />
                    <ItemsControl x:Name="YearlyChart" Margin="0,20,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="60" /><ColumnDefinition Width="*" /><ColumnDefinition Width="95" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding PeriodLabel}" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Height="18" Maximum="100" Value="{Binding BarWidth}" Foreground="#1769E0" Background="#DCEBFF" BorderThickness="0" />
                                    <TextBlock Grid.Column="2" Text="{Binding Revenue, StringFormat={}{0:N0}}" Foreground="#315A91" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
