<Window x:Class="StarGymApp.Desktop.PhotoCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capture member photo" Width="620" Height="560" MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterOwner" Icon="{StaticResource StarGymLogo}"
        Background="#F4F7FB" Foreground="#10233F">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="MEMBER PHOTO" FontSize="10" FontWeight="Bold" Foreground="#1769E0" />
            <TextBlock Text="Position the member in the frame" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Background="#0B2E68" CornerRadius="12" ClipToBounds="True">
            <Image x:Name="CameraPreviewImage" Stretch="Uniform" />
        </Border>
        <TextBlock x:Name="CameraStatusText" Grid.Row="2" Text="Connecting to camera..." Foreground="#6B7E99" Margin="0,12,0,14" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="96" Margin="0,0,8,0" Click="CancelButton_OnClick" />
            <Button x:Name="CaptureButton" Content="Capture photo" Width="130" Margin="0,0,8,0" IsEnabled="False" Click="CaptureButton_OnClick" />
            <Button x:Name="UsePhotoButton" Content="Use photo" Width="110" Background="#1769E0" Foreground="White" BorderBrush="#1769E0" IsEnabled="False" Click="UsePhotoButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
