<Window x:Class="StarGymApp.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:StarGymApp.Desktop"
        Title="StarGym - Owner Console" Width="1440" Height="900" MinWidth="1050" MinHeight="680"
        Icon="{StaticResource StarGymLogo}" Background="#F4F7FB" Foreground="#10233F">
    <Window.Resources>
        <SolidColorBrush x:Key="BlueBrush" Color="#1769E0" />
        <SolidColorBrush x:Key="DeepBlueBrush" Color="#0B2E68" />
        <SolidColorBrush x:Key="LogoGoldBrush" Color="#B9D7FF" />
        <SolidColorBrush x:Key="LogoGoldLightBrush" Color="#B9D7FF" />
        <SolidColorBrush x:Key="InkBrush" Color="#10233F" />
        <SolidColorBrush x:Key="MutedBrush" Color="#6B7E99" />
        <SolidColorBrush x:Key="NavTextBrush" Color="#D5E5FF" />
        <SolidColorBrush x:Key="LineBrush" Color="#DDE6F2" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SoftBlueBrush" Color="#EAF2FF" />
        <local:MemberPhotoConverter x:Key="MemberPhotoConverter" />
        <DataTemplate x:Key="SubscriptionStatusTemplate">
            <Border x:Name="StatusBadge" Background="#EAF2FF" CornerRadius="10" Padding="9,5" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#1769E0" Margin="0,0,7,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusLabel" Text="{Binding SubscriptionStatus}" Foreground="#315A91" FontSize="11" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding SubscriptionStatus}" Value="Active">
                    <Setter TargetName="StatusBadge" Property="Background" Value="#E9F7EF" />
                    <Setter TargetName="StatusDot" Property="Fill" Value="#21865F" />
                    <Setter TargetName="StatusLabel" Property="Foreground" Value="#21865F" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SubscriptionStatus}" Value="Expired">
                    <Setter TargetName="StatusBadge" Property="Background" Value="#FFF1F1" />
                    <Setter TargetName="StatusDot" Property="Fill" Value="#C54646" />
                    <Setter TargetName="StatusLabel" Property="Foreground" Value="#C54646" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="HistorySubscriptionStatusTemplate">
            <Border x:Name="HistoryStatusBadge" Background="#E9F7EF" CornerRadius="10" Padding="8,4" HorizontalAlignment="Left">
                <TextBlock x:Name="HistoryStatusLabel" Text="{Binding Member.SubscriptionStatus}" Foreground="#21865F" FontSize="11" FontWeight="SemiBold" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Member.SubscriptionStatus}" Value="Expired">
                    <Setter TargetName="HistoryStatusBadge" Property="Background" Value="#FFF1F1" />
                    <Setter TargetName="HistoryStatusLabel" Property="Foreground" Value="#C54646" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Member.SubscriptionStatus}" Value="Paused">
                    <Setter TargetName="HistoryStatusBadge" Property="Background" Value="#FFF7E8" />
                    <Setter TargetName="HistoryStatusLabel" Property="Foreground" Value="#A66A00" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Member.SubscriptionStatus}" Value="Inactive">
                    <Setter TargetName="HistoryStatusBadge" Property="Background" Value="#F0F2F5" />
                    <Setter TargetName="HistoryStatusLabel" Property="Foreground" Value="#617795" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF" /><Setter Property="Foreground" Value="#10233F" />
            <Setter Property="BorderBrush" Value="#D4E0EF" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" /><Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFF" /><Setter Property="Foreground" Value="#10233F" />
            <Setter Property="BorderBrush" Value="#D4E0EF" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" /><Setter Property="Foreground" Value="#24405F" />
            <Setter Property="BorderBrush" Value="#D4E0EF" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,9" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#D5E5FF" />
            <Setter Property="BorderThickness" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Height" Value="48" /><Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#174887" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListView">
            <Setter Property="Background" Value="#FFFFFF" /><Setter Property="Foreground" Value="#10233F" />
            <Setter Property="BorderBrush" Value="#DDE6F2" /><Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="#10233F" /><Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EFF5FF" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DCEBFF" /><Setter Property="Foreground" Value="#244A7A" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#F2F6FC" /><Setter Property="Foreground" Value="#617795" />
            <Setter Property="FontWeight" Value="Bold" /><Setter Property="Padding" Value="12,10" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="244" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#0B2E68">
            <DockPanel Margin="20,26">
                <StackPanel DockPanel.Dock="Top">
                    <Grid Margin="2,0,0,5" Height="74">
                        <Path Data="M 34,0 L 43,25 L 70,25 L 48,41 L 57,67 L 34,51 L 11,67 L 20,41 L 0,25 L 26,25 Z" Fill="{StaticResource LogoGoldBrush}" Stretch="Uniform" Width="68" Height="68" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <StackPanel Margin="82,4,0,0"><TextBlock Text="STAR" FontSize="25" FontWeight="Bold" Foreground="White" /><TextBlock Text="GYM" FontSize="25" FontWeight="Bold" Foreground="{StaticResource LogoGoldBrush}" Margin="0,-7,0,0" /></StackPanel>
                    </Grid>
                    <Path Data="M 0,0 C 55,28 150,27 214,0" Stroke="{StaticResource LogoGoldLightBrush}" StrokeThickness="3" Stretch="Fill" Width="210" Height="18" Margin="7,-10,0,4" />
                    <TextBlock Text="FITNESS CLUB MANAGEMENT" FontSize="9" Foreground="#A9C8F5" Margin="7,0,0,34" />
                    <TextBlock Text="GYM FLOOR" FontSize="10" FontWeight="Bold" Foreground="#91B5E8" Margin="8,0,0,12" />
                    <Button x:Name="DashboardNavButton" Style="{StaticResource NavButtonStyle}" Click="DashboardNavButton_OnClick" Background="#1769E0" Foreground="White"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" Width="28" FontSize="16"/><TextBlock Text="Dashboard"/></StackPanel></Button>
                    <Button x:Name="MembersNavButton" Style="{StaticResource NavButtonStyle}" Click="MembersNavButton_OnClick"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE716;" Width="28" FontSize="16"/><TextBlock Text="Members"/></StackPanel></Button>
                    <Button x:Name="ReportsNavButton" Style="{StaticResource NavButtonStyle}" Click="ReportsNavButton_OnClick"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D2;" Width="28" FontSize="16"/><TextBlock Text="Reports"/></StackPanel></Button>
                    <Button x:Name="BadgeScannerNavButton" Style="{StaticResource NavButtonStyle}" Click="BadgeScannerNavButton_OnClick"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" Width="28" FontSize="16"/><TextBlock Text="Badge check-in"/></StackPanel></Button>
                    <Button x:Name="MemberHistoryNavButton" Style="{StaticResource NavButtonStyle}" Click="MemberHistoryNavButton_OnClick"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE81C;" Width="28" FontSize="16"/><TextBlock Text="Member history"/></StackPanel></Button>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Height="230" CornerRadius="12" Margin="0,20,0,0" ClipToBounds="True">
                    <Image Source="pack://application:,,,/Assets/gym-sidebar-card.png" Stretch="UniformToFill" />
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="42,30,48,42">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,28">
                <StackPanel DockPanel.Dock="Left"><TextBlock Text="STARGYM / PERFORMANCE HUB" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BlueBrush}" /><TextBlock x:Name="PageTitleText" Text="Dashboard" FontSize="32" FontWeight="Bold" Margin="0,5,0,0" /><TextBlock x:Name="PageSubtitleText" Text="A clear view of today's gym operations." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" /></StackPanel>
                <Border DockPanel.Dock="Right" Background="#EAF2FF" BorderBrush="#B9D7FF" BorderThickness="1" CornerRadius="20" Padding="15,9" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#1769E0" Margin="0,0,8,0" /><TextBlock Text="GYM FLOOR LIVE" FontSize="10" FontWeight="Bold" Foreground="#1769E0" /></StackPanel></Border>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid x:Name="DashboardPage"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <Border Background="{StaticResource DeepBlueBrush}" CornerRadius="16" Padding="24" Margin="0,0,0,24" ClipToBounds="True">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                            <Image Grid.Column="1" Source="pack://application:,,,/Assets/gym-hero.png" Stretch="Uniform" MaxWidth="470" MaxHeight="160" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="4,2,12,2">
                                <Border Background="#174887" CornerRadius="12" Padding="10,5" HorizontalAlignment="Left">
                                    <TextBlock Text="TODAY'S TRAINING PULSE" FontSize="10" FontWeight="Bold" Foreground="#D0E2FF" />
                                </Border>
                                <TextBlock Text="Build a stronger gym." FontSize="34" FontWeight="Bold" Foreground="White" Margin="0,10,0,4" />
                                <TextBlock Text="Your team has the numbers. Now turn them into momentum." FontSize="14" Foreground="#D0E2FF" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DockPanel Margin="0,0,0,12"><TextBlock Text="AT A GLANCE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="MEMBERSHIP &amp; REVENUE" DockPanel.Dock="Right" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" /></DockPanel>
                    <UniformGrid Columns="4" Margin="0,0,0,24">
                        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="TOTAL MEMBERS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="TotalMembersText" Text="--" FontSize="31" FontWeight="Bold" Foreground="{StaticResource InkBrush}" Margin="0,9,0,0"/><TextBlock Text="registered profiles" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel><Border Grid.Column="1" Width="32" Height="32" CornerRadius="10" Background="{StaticResource SoftBlueBrush}" VerticalAlignment="Top"><TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
                        <Border Background="#F5F9FF" BorderBrush="#CFE0F6" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ACTIVE MEMBERS" FontSize="10" FontWeight="Bold" Foreground="#4B75A6"/><TextBlock x:Name="ActiveMembersText" Text="--" FontSize="31" FontWeight="Bold" Foreground="{StaticResource BlueBrush}" Margin="0,9,0,0"/><TextBlock Text="current subscriptions" FontSize="11" Foreground="#6A8CB5" Margin="0,3,0,0"/></StackPanel><Border Grid.Column="1" Width="32" Height="32" CornerRadius="10" Background="#E9F7EF" VerticalAlignment="Top"><TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#21865F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
                        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="EXPIRED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ExpiredMembersText" Text="--" FontSize="31" FontWeight="Bold" Foreground="#C54646" Margin="0,9,0,0"/><TextBlock Text="renewal follow-up" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel><Border Grid.Column="1" Width="32" Height="32" CornerRadius="10" Background="#FFF1F1" VerticalAlignment="Top"><TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#C54646" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
                        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="MONTHLY REVENUE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="MonthlyRevenueText" Text="--" FontSize="31" FontWeight="Bold" Foreground="#1769E0" Margin="0,9,0,0"/><TextBlock Text="paid this month" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel><Border Grid.Column="1" Width="32" Height="32" CornerRadius="10" Background="#FFF7E8" VerticalAlignment="Top"><TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#A66A00" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
                    </UniformGrid>
                    <Border Background="#F7FAFF" BorderBrush="#DCE7F5" BorderThickness="1" CornerRadius="18" Padding="22" Margin="0,0,0,24">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="KPI MOMENTUM" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BlueBrush}" />
                                    <TextBlock Text="Your gym at a glance" FontSize="21" FontWeight="Bold" Foreground="{StaticResource InkBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Border DockPanel.Dock="Right" Background="#E8F7F0" CornerRadius="14" Padding="11,7" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="#28A875" Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock Text="LIVE SNAPSHOT" Foreground="#21865F" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.12*" /><ColumnDefinition Width="0.88*" /></Grid.ColumnDefinitions>
                                <Border Background="{StaticResource DeepBlueBrush}" CornerRadius="16" Padding="20" Margin="0,0,12,0" ClipToBounds="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="108" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Fill="#57D6A0" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="LIVE FLOOR" FontSize="9" FontWeight="Bold" Foreground="#B9D7FF" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="Members in gym" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,14,0,0" />
                                            <TextBlock Text="Currently checked in" FontSize="10" Foreground="#B9D7FF" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Grid Grid.Column="1" Width="96" Height="96" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Ellipse Stroke="#28528A" StrokeThickness="7" />
                                            <Ellipse Stroke="#57D6A0" StrokeThickness="7" StrokeDashArray="2 1.2" />
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock x:Name="MembersInGymNowText" Text="0" FontSize="30" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                                                <TextBlock Text="NOW" FontSize="8" FontWeight="Bold" Foreground="#B9D7FF" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <Border Background="White" BorderBrush="#DCE7F5" BorderThickness="1" CornerRadius="14" Padding="15">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="11" Background="#E8F7F0" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#21865F" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                <TextBlock Text="TODAY'S CHECK-INS" FontSize="9" FontWeight="Bold" Foreground="#6B7E99" />
                                                <TextBlock Text="Visits recorded today" FontSize="10" Foreground="#6B7E99" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <TextBlock x:Name="TodaysCheckInsText" Grid.Column="2" Text="0" FontSize="26" FontWeight="Bold" Foreground="#21865F" VerticalAlignment="Center" Margin="10,0,0,0" />
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="2" Background="White" BorderBrush="#DCE7F5" BorderThickness="1" CornerRadius="14" Padding="15">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="11" Background="#EAF2FF" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                <TextBlock Text="MONTHLY ATTENDANCE" FontSize="9" FontWeight="Bold" Foreground="#6B7E99" />
                                                <TextBlock Text="Visits this month" FontSize="10" Foreground="#6B7E99" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <TextBlock x:Name="AttendanceKpiValue" Grid.Column="2" Text="--" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BlueBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="MONTHLY PACE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <ProgressBar x:Name="AttendanceKpiBar" Grid.Column="1" Height="7" Maximum="100" Value="0" Foreground="#28A875" Background="#E5EDF7" BorderThickness="0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="20 VISITS" FontSize="8" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                            </Grid>
                            <Border Background="#F7FAFF" BorderBrush="#E5EDF7" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,22,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,18,0">
                                        <DockPanel>
                                            <StackPanel>
                                                <TextBlock Text="WEEKLY VISIT RHYTHM" FontSize="10" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                                <TextBlock Text="Check-ins by day · last 7 days" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Border DockPanel.Dock="Right" Background="#EAF2FF" CornerRadius="9" Padding="8,4" VerticalAlignment="Center">
                                                <TextBlock Text="DAILY" FontSize="8" FontWeight="Bold" Foreground="{StaticResource BlueBrush}" />
                                            </Border>
                                        </DockPanel>
                                        <Canvas x:Name="AttendanceTrendCanvas" Height="88" Margin="0,8,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="White" BorderBrush="#DCE7F5" BorderThickness="1" CornerRadius="12" Padding="14">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="FLOOR ACTIVITY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                                            <DockPanel Margin="0,7,0,0">
                                                <TextBlock x:Name="ActivityRingText" Text="0%" FontSize="27" FontWeight="Bold" Foreground="{StaticResource BlueBrush}" />
                                                <TextBlock Text="of active members" FontSize="9" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="7,0,0,5" />
                                            </DockPanel>
                                            <ProgressBar x:Name="FloorActivityBar" Height="7" Maximum="100" Value="0" Foreground="{StaticResource BlueBrush}" Background="#EAF2FF" BorderThickness="0" Margin="0,8,0,0" />
                                            <TextBlock x:Name="FloorActivitySummaryText" Text="0 of 0 active members on the floor" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel></ScrollViewer></Grid>

                <Grid x:Name="BadgeScannerPage" Visibility="Collapsed"><local:BadgeScannerPanel x:Name="BadgeScannerPanelControl" /></Grid>
                <Grid x:Name="MemberHistoryPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource DeepBlueBrush}" CornerRadius="14" Padding="22,18" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#B9D7FF" VerticalAlignment="Center" Margin="0,0,9,0" />
                                    <TextBlock Text="BADGE ACTIVITY" FontSize="11" FontWeight="Bold" Foreground="#B9D7FF" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Every member entry, with the latest check-in at the top." FontSize="14" Foreground="White" Margin="0,7,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#174887" BorderBrush="#3D6FAE" BorderThickness="1" CornerRadius="10" Padding="14,9" VerticalAlignment="Center" Margin="20,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="MOST RECENT ENTRY" FontSize="9" FontWeight="Bold" Foreground="#B9D7FF" HorizontalAlignment="Right" />
                                    <TextBlock x:Name="LatestCheckInText" Text="No entries yet" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,4,0,0" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <ListView x:Name="MemberHistoryList" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,10" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="1.25*" />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="1.15*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="96" Height="96" CornerRadius="48" Background="#EAF2FF" BorderBrush="#D8E6F8" BorderThickness="2" ClipToBounds="True" VerticalAlignment="Center">
                                            <Image Source="{Binding Member, Converter={StaticResource MemberPhotoConverter}}" Stretch="UniformToFill">
                                                <Image.Clip><EllipseGeometry Center="48,48" RadiusX="48" RadiusY="48" /></Image.Clip>
                                            </Image>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,18,0">
                                            <TextBlock Text="{Binding Member.FullName}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Member.Phone}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Border Background="#EAF2FF" CornerRadius="8" Padding="8,4">
                                                    <TextBlock Text="{Binding Member.BadgeId}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}" />
                                                </Border>
                                                <TextBlock Text="{Binding Member.Age, StringFormat={}{0} years}" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Rectangle Grid.Column="2" Fill="{StaticResource LineBrush}" Margin="0,8" />
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="20,0">
                                            <TextBlock Text="CHECK-IN" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource BlueBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                <TextBlock Text="{Binding Attendance.CheckInDate, StringFormat={}{0:MMM d, yyyy}}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Attendance.CheckInTime, StringFormat={}{0:hh\\:mm}}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding RecencyLabel}" FontSize="11" Foreground="{StaticResource BlueBrush}" FontWeight="SemiBold" Margin="0,5,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="108">
                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource HistorySubscriptionStatusTemplate}" />
                                            <TextBlock Text="JOINED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,3" />
                                            <TextBlock Text="{Binding Member.JoinDate, StringFormat={}{0:yyyy-MM-dd}}" FontSize="11" Foreground="{StaticResource InkBrush}" />
                                            <TextBlock Text="EXPIRES" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,3" />
                                            <TextBlock Text="{Binding Member.MembershipExpiresOn, StringFormat={}{0:yyyy-MM-dd}}" FontSize="11" Foreground="{StaticResource InkBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
                <Grid x:Name="MembersPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource DeepBlueBrush}" CornerRadius="14" Padding="20,16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#B9D7FF" VerticalAlignment="Center" Margin="0,0,9,0" />
                                        <TextBlock Text="MEMBER DIRECTORY" FontSize="11" FontWeight="Bold" Foreground="#B9D7FF" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Manage member profiles, subscriptions, and gym access." FontSize="14" Foreground="White" Margin="0,6,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="+  Add new client" Height="40" Margin="20,0,0,0" Padding="18,0" Background="White" Foreground="{StaticResource DeepBlueBrush}" BorderThickness="0" Click="AddMemberButton_OnClick" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="MemberSearchBox" Height="40" TextChanged="MemberSearchBox_OnTextChanged" ToolTip="Search by name, phone, or badge ID" />
                                <ComboBox x:Name="MemberStatusFilter" Grid.Column="1" Height="40" Margin="10,0,0,0" SelectionChanged="MemberStatusFilter_OnSelectionChanged" SelectedIndex="0">
                                    <ComboBoxItem Content="All statuses" Tag="" />
                                    <ComboBoxItem Content="Active" Tag="Active" />
                                    <ComboBoxItem Content="Expired" Tag="Expired" />
                                    <ComboBoxItem Content="Paused" Tag="Paused" />
                                    <ComboBoxItem Content="Inactive" Tag="Inactive" />
                                </ComboBox>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="2" Margin="2,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Renew subscription" Height="36" Background="#EAF2FF" Foreground="{StaticResource BlueBrush}" BorderBrush="#CFE0F6" Click="RenewMembershipButton_OnClick" />
                                <Button Content="Edit selected" Height="36" Margin="8,0,0,0" Click="EditMemberButton_OnClick" />
                                <Button Content="Remove client" Height="36" Margin="8,0,0,0" Foreground="#C54646" Click="DeleteMemberButton_OnClick" />
                            </StackPanel>
                            <TextBlock x:Name="MembersCountText" Text="Members" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>
                    <ListView x:Name="MembersList" Grid.Row="1" Background="Transparent" BorderThickness="0" MinHeight="300" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,10" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="1.3*" />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1.05*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="96" Height="96" CornerRadius="48" Background="#EAF2FF" BorderBrush="#D8E6F8" BorderThickness="2" ClipToBounds="True" VerticalAlignment="Center">
                                            <Image Source="{Binding Converter={StaticResource MemberPhotoConverter}}" Stretch="UniformToFill">
                                                <Image.Clip><EllipseGeometry Center="48,48" RadiusX="48" RadiusY="48" /></Image.Clip>
                                            </Image>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,18,0">
                                            <TextBlock Text="{Binding FullName}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Phone}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Border Background="#EAF2FF" CornerRadius="8" Padding="8,4">
                                                    <TextBlock Text="{Binding BadgeId}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}" />
                                                </Border>
                                                <TextBlock Text="{Binding Age, StringFormat={}{0} years}" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Rectangle Grid.Column="2" Fill="{StaticResource LineBrush}" Margin="0,8" />
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="20,0">
                                            <TextBlock Text="MEMBERSHIP" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SubscriptionStatusTemplate}" Margin="0,6,0,0" />
                                            <TextBlock Text="TRAINING PERIOD" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,3" />
                                            <TextBlock Text="{Binding MembershipTermLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                            <TextBlock Text="EXPIRES" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,11,0,3" />
                                            <TextBlock Text="{Binding MembershipExpiresOn, StringFormat={}{0:yyyy-MM-dd}}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                            <TextBlock Text="PRICE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,3" />
                                            <TextBlock Text="{Binding MembershipPrice, StringFormat={}{0:N2}}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,0,0">
                                            <TextBlock Text="MEMBER SINCE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource BlueBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                <TextBlock Text="{Binding JoinDate, StringFormat={}{0:MMM d, yyyy}}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="MEMBER PROFILE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,13,0,3" />
                                            <TextBlock Text="{Binding Email}" FontSize="11" Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid x:Name="ReportsPage" Visibility="Collapsed"><StackPanel><TextBlock Text="PERFORMANCE REPORTS" FontSize="22" FontWeight="Bold" /><TextBlock Text="Business signals for decisions that keep the gym moving." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,22" /><UniformGrid Columns="2"><Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,0,10,10"><StackPanel><TextBlock Text="PAID REVENUE" FontSize="11" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="PaidRevenueReportText" Text="--" FontSize="32" FontWeight="Bold" Foreground="{StaticResource BlueBrush}" Margin="0,9,0,0" /><TextBlock Text="total paid revenue" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" /></StackPanel></Border><Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="24" Margin="10,0,0,10"><StackPanel><TextBlock Text="PENDING / OVERDUE" FontSize="11" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="PendingPaymentsReportText" Text="--" FontSize="32" FontWeight="Bold" Foreground="#E28B35" Margin="0,9,0,0" /><TextBlock Text="payments needing attention" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" /></StackPanel></Border><Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,10,10,0"><StackPanel><TextBlock Text="EXPIRING MEMBERS" FontSize="11" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="ExpiringMembersReportText" Text="--" FontSize="32" FontWeight="Bold" Foreground="#E25555" Margin="0,9,0,0" /><TextBlock Text="renewal opportunities" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" /></StackPanel></Border><Border Background="#EAF2FF" BorderBrush="#B9D7FF" BorderThickness="1" CornerRadius="12" Padding="24" Margin="10,10,0,0"><StackPanel><TextBlock Text="ATTENDANCE THIS MONTH" FontSize="11" Foreground="{StaticResource BlueBrush}" /><TextBlock x:Name="MonthlyAttendanceReportText" Text="--" FontSize="32" FontWeight="Bold" Foreground="{StaticResource BlueBrush}" Margin="0,9,0,0" /><TextBlock Text="sessions recorded" Foreground="#58789F" Margin="0,4,0,0" /></StackPanel></Border></UniformGrid><Button Content="Backup database" Width="160" Height="42" HorizontalAlignment="Left" Margin="0,24,0,0" Click="BackupButton_OnClick" /></StackPanel></Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
