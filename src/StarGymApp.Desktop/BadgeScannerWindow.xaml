<Window x:Class="StarGymApp.Desktop.BadgeScannerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="StarGym - Badge Check-in" Width="980" Height="680" Icon="{StaticResource StarGymLogo}" Background="#F4F7FB" Foreground="#10233F" WindowStartupLocation="CenterOwner">
 <Window.Resources><SolidColorBrush x:Key="BlueBrush" Color="#1769E0"/><SolidColorBrush x:Key="DeepBlueBrush" Color="#0B2E68"/><SolidColorBrush x:Key="MutedBrush" Color="#6B7E99"/><SolidColorBrush x:Key="LineBrush" Color="#DDE6F2"/><SolidColorBrush x:Key="SoftBlueBrush" Color="#EAF2FF"/><Style TargetType="TextBox"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#10233F"/><Setter Property="BorderBrush" Value="#B9D7FF"/><Setter Property="BorderThickness" Value="2"/><Setter Property="Padding" Value="16,10"/><Setter Property="FontSize" Value="18"/></Style><Style TargetType="Button"><Setter Property="Background" Value="#1769E0"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,10"/><Setter Property="FontWeight" Value="Bold"/></Style></Window.Resources>
 <Grid Margin="34"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,28"><StackPanel><TextBlock Text="STARGYM / ENTRY DESK" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BlueBrush}"/><TextBlock Text="Badge check-in" FontSize="32" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="Scan a member badge to open their gym profile instantly." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel><Border DockPanel.Dock="Right" Background="{StaticResource SoftBlueBrush}" CornerRadius="18" Padding="14,9" VerticalAlignment="Center"><TextBlock Text="READY TO SCAN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BlueBrush}"/></Border></DockPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="{StaticResource DeepBlueBrush}" CornerRadius="16" Padding="24" Margin="0,0,12,0"><StackPanel><TextBlock Text="SCAN BADGE" FontSize="11" FontWeight="Bold" Foreground="#9CC9FF"/><TextBlock Text="Present the member badge to the scanner." FontSize="21" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" Margin="0,12,0,22"/><TextBox x:Name="BadgeInput" Height="52" KeyDown="BadgeInput_OnKeyDown"/><Button Content="Find member" Height="46" Margin="0,12,0,0" Click="FindMemberButton_OnClick"/><TextBlock Text="Example: 10000001" Foreground="#BBD5F5" FontSize="12" Margin="0,20,0,0"/><TextBlock x:Name="ScanStatusText" Text="Waiting for a badge..." Foreground="#D0E2FF" FontSize="13" Margin="0,8,0,0"/></StackPanel></Border><Border Grid.Column="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="26" Margin="12,0,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,8,20,0"><Border Background="{StaticResource SoftBlueBrush}" CornerRadius="62" Width="118" Height="118"><Image x:Name="MemberPhoto" Width="108" Height="108" Stretch="UniformToFill"/></Border><TextBlock Text="VISUAL CONFIRMATION" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="MEMBER PROFILE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BlueBrush}"/><TextBlock x:Name="MemberNameText" Text="No member scanned" FontSize="29" FontWeight="Bold" Margin="0,8,0,18"/><UniformGrid Columns="3" Margin="0,0,0,18"><StackPanel><TextBlock Text="BADGE ID" FontSize="10" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="BadgeText" Text="--" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BlueBrush}" Margin="0,5,0,0"/></StackPanel><StackPanel><TextBlock Text="PHONE" FontSize="10" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="PhoneText" Text="--" FontSize="15" Margin="0,5,0,0"/></StackPanel><StackPanel><TextBlock Text="AGE" FontSize="10" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="AgeText" Text="--" FontSize="15" Margin="0,5,0,0"/></StackPanel></UniformGrid><Border Background="{StaticResource SoftBlueBrush}" CornerRadius="10" Padding="15" Margin="0,0,0,15"><UniformGrid Columns="2"><StackPanel><TextBlock Text="MEMBERSHIP STATUS" FontSize="10" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="MembershipStatusText" Text="--" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BlueBrush}" Margin="0,5,0,0"/></StackPanel><StackPanel><TextBlock Text="EXPIRES" FontSize="10" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ExpiryText" Text="--" FontSize="18" FontWeight="Bold" Foreground="#E25555" Margin="0,5,0,0"/></StackPanel></UniformGrid></Border><UniformGrid Columns="2"><StackPanel><TextBlock Text="MEMBERSHIP STARTED" FontSize="10" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="StartDateText" Text="--" FontSize="15" Margin="0,5,0,0"/></StackPanel><StackPanel><TextBlock Text="TOTAL PAID" FontSize="10" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="TotalPaidText" Text="--" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BlueBrush}" Margin="0,5,0,0"/></StackPanel></UniformGrid><TextBlock x:Name="VisitsText" Text="Visits: --" Foreground="#1769E0" FontSize="15" FontWeight="Bold" Margin="0,12,0,0"/><TextBlock x:Name="LastPaymentText" Text="Last payment: --" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/><Button x:Name="CheckInButton" Content="Check in member" Height="42" Margin="0,12,0,0" Click="CheckInButton_OnClick"/></StackPanel></Grid></Border></Grid></Grid>
</Window>
