<Window x:Class="StarGymApp.Desktop.RevenueReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StarGym - Revenue Timeline" Width="1120" Height="760" MinWidth="900" MinHeight="600"
        Icon="{StaticResource StarGymLogo}" Background="#F4F7FB" Foreground="#10233F">
    <Window.Resources>
        <SolidColorBrush x:Key="BlueBrush" Color="#1769E0"/><SolidColorBrush x:Key="InkBrush" Color="#10233F"/><SolidColorBrush x:Key="MutedBrush" Color="#6B7E99"/><SolidColorBrush x:Key="LineBrush" Color="#DDE6F2"/><SolidColorBrush x:Key="SoftBlueBrush" Color="#EAF2FF"/>
        <Style TargetType="ComboBox"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#10233F"/><Setter Property="BorderBrush" Value="#D4E0EF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Height" Value="38"/></Style>
        <Style TargetType="Button"><Setter Property="Background" Value="#1769E0"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,8"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="42">
        <DockPanel Margin="0,0,0,28"><StackPanel><TextBlock Text="STARGYM / REPORTS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BlueBrush}"/><TextBlock Text="Revenue timeline" FontSize="34" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="See how the business performs across months and years." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="Close" Width="90" Height="38" Click="CloseButton_OnClick"/></DockPanel>
        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,0,0,20"><StackPanel><DockPanel><StackPanel><TextBlock Text="MONTHLY REVENUE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BlueBrush}"/><TextBlock Text="Revenue by month" FontSize="21" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel><ComboBox x:Name="YearFilter" Width="130" DockPanel.Dock="Right" SelectionChanged="YearFilter_OnSelectionChanged"/></DockPanel><ItemsControl x:Name="MonthlyChart" Margin="0,24,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions><TextBlock Text="{Binding PeriodLabel}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>        <ProgressBar Grid.Column="1" Height="18" Maximum="100" Value="{Binding BarWidth}" Foreground="{StaticResource BlueBrush}" Background="#E8EEF7" BorderThickness="0"/><TextBlock Grid.Column="2" Text="{Binding Revenue, StringFormat={}{0:N0}}" Foreground="{StaticResource InkBrush}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                <Border Background="{StaticResource SoftBlueBrush}" BorderBrush="#B9D7FF" BorderThickness="1" CornerRadius="14" Padding="24"><StackPanel><TextBlock Text="YEARLY COMPARISON" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BlueBrush}"/><TextBlock Text="Paid revenue by year" FontSize="21" FontWeight="Bold" Margin="0,4,0,0"/><ItemsControl x:Name="YearlyChart" Margin="0,24,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions><TextBlock Text="{Binding PeriodLabel}" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/><ProgressBar Grid.Column="1" Height="18" Maximum="100" Value="{Binding BarWidth}" Foreground="#1769E0" Background="#DCEBFF" BorderThickness="0"/><TextBlock Grid.Column="2" Text="{Binding Revenue, StringFormat={}{0:N0}}" Foreground="#315A91" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
    </StackPanel></ScrollViewer>
</Window>
