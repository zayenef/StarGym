    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>StarGymApp.Core</RootNamespace>
    <AssemblyName>StarGymApp.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Data\starter-data.json">
